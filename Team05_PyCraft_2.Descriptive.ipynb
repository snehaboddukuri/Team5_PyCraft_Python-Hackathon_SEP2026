    "mortality_lab = []\n",
    "\n",
    "for col in lab_cols:\n",
    "\n",
    "    survived_mean = (\n",
    "        lab_df.loc[\n",
    "            lab_df['death_6m'] == 0,\n",
    "            col\n",
    "        ].mean()\n",
    "    )\n",
    "\n",
    "    died_mean = (\n",
    "        lab_df.loc[\n",
    "            lab_df['death_6m'] == 1,\n",
    "            col\n",
    "        ].mean()\n",
    "    )\n",
    "\n",
    "    difference = abs(\n",
    "        died_mean - survived_mean\n",
    "    )\n",
    "\n",
    "    mortality_lab.append([\n",
    "        col,\n",
    "        survived_mean,\n",
    "        died_mean,\n",
    "        difference\n",
    "    ])\n",
    "\n",
    "mortality_lab = pd.DataFrame(\n",
    "    mortality_lab,\n",
    "    columns=[\n",
    "        'Lab_Marker',\n",
    "        'Survived_Mean',\n",
    "        'Died_Mean',\n",
    "        'Difference'\n",
    "    ]\n",
    ")\n",
    "\n",
    "mortality_lab.sort_values(\n",
    "    'Difference',\n",
    "    ascending=False\n",
    ")"
   ]
