   "source": [
    "#highest mortality risk combination\n",
    "combo_risk = (\n",
    "    risk_df.groupby('disease_combination')\n",
    "           .agg(\n",
    "               Patients=('patient_id', 'count'),\n",
    "               Deaths=('death_6m', 'sum')\n",
    "           )\n",
    ")\n",
    "\n",
    "combo_risk['Mortality_Rate'] = (\n",
    "    combo_risk['Deaths']\n",
    "    /\n",
    "    combo_risk['Patients']\n",
    "    * 100\n",
    ")\n",
    "\n",
    "combo_risk = combo_risk[\n",
    "    combo_risk['Patients'] >= 10\n",
    "]\n",
    "\n",
    "combo_risk = combo_risk.sort_values(\n",
    "    'Mortality_Rate',\n",
    "    ascending=False\n",
    ")\n",
    "\n",
    "combo_risk.head(20)"
   ]
  },
