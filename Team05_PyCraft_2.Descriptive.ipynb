    "from sklearn.ensemble import RandomForestClassifier\n",
    "\n",
    "X = (\n",
    "    lab_df[lab_cols]\n",
    "    .fillna(\n",
    "        lab_df[lab_cols].median()\n",
    "    )\n",
    ")\n",
    "\n",
    "y = lab_df['death_6m']\n",
    "\n",
    "rf = RandomForestClassifier(\n",
    "    n_estimators=200,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "rf.fit(X, y)\n",
    "\n",
    "importance_df = pd.DataFrame({\n",
    "    'Marker': lab_cols,\n",
    "    'Importance': rf.feature_importances_\n",
    "})\n",
    "\n",
    "importance_df = (\n",
    "    importance_df\n",
    "    .sort_values(\n",
    "        'Importance',\n",
    "        ascending=False\n",
    "    )\n",
    ")\n",
    "\n",
    "print(importance_df)"
   ]
