mortality_lab = []

for col in lab_cols:

    survived = master_df.loc[
        master_df['death_6m'] == 0,
        col
    ].mean()

    died = master_df.loc[
        master_df['death_6m'] == 1,
        col
    ].mean()

    difference = abs(died - survived)

    mortality_lab.append([
        col,
        survived,
        died,
        difference
    ])

mortality_lab = pd.DataFrame(
    mortality_lab,
    columns=[
        'Lab_Marker',
        'Survived_Mean',
        'Died_Mean',
        'Difference'
    ]
)

mortality_lab.sort_values(
    'Difference',
    ascending=False
)



from scipy.stats import ttest_ind

results = []

for col in lab_cols:

    dead = master_df.loc[
        master_df['death_6m']==1,
        col
    ].dropna()

    alive = master_df.loc[
        master_df['death_6m']==0,
        col
    ].dropna()

    stat, p = ttest_ind(
        dead,
        alive,
        equal_var=False
    )

    results.append([
        col,
        p
    ])

lab_significance = pd.DataFrame(
    results,
    columns=['Marker','P_Value']
)

lab_significance.sort_values(
    'P_Value'
)


from sklearn.ensemble import RandomForestClassifier

X = master_df[lab_cols].fillna(
    master_df[lab_cols].median()
)

y = master_df['death_6m']

rf = RandomForestClassifier(
    n_estimators=200,
    random_state=42
)

rf.fit(X,y)

importance_df = pd.DataFrame({
    'Marker': lab_cols,
    'Importance': rf.feature_importances_
})

importance_df.sort_values(
    'Importance',
    ascending=False
)


import seaborn as sns
import matplotlib.pyplot as plt

top_markers = (
    importance_df
    .sort_values(
        'Importance',
        ascending=False
    )
)

plt.figure(figsize=(10,20))

sns.barplot(
    data=top_markers,
    x='Importance',
    y='Marker'
)

plt.title(
    'Laboratory Markers Most Associated with 6-Month Mortality'
)

plt.show()








