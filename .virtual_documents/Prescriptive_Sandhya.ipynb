def find_high_mortality_profiles(df):
    # Define time-bound death flags based on discharge vs death date
    df['days_to_death'] = (pd.to_datetime(df['death_date']) - pd.to_datetime(df['discharge_date'])).dt.days
    
    df['died_28d'] = (df['days_to_death'] <= 28).astype(int)
    df['died_3m'] = (df['days_to_death'] <= 90).astype(int)
    df['died_6m'] = (df['days_to_death'] <= 180).astype(int)
    
    # Create descriptive profile bins (Example features: Age and SBP)
    df['age_group'] = pd.cut(df['age'], bins=[0, 50, 70, 100], labels=['<50', '50-70', '70+'])
    df['sbp_group'] = pd.cut(df['sbp'], bins=[0, 90, 140, 300], labels=['Hypotensive', 'Normal', 'Hypertensive'])
    
    # Group by profile characteristics and look at mean mortality rates
    profile_cols = ['age_group', 'sbp_group', 'gender']
    
    mortality_summary = df.groupby(profile_cols).agg(
        total_patients=('inpatient_number', 'count'),
        mortality_28d=('died_28d', 'mean'),
        mortality_3m=('died_3m', 'mean'),
        mortality_6m=('died_6m', 'mean')
    ).reset_index()
    
    # Filter out statistically insignificant small subgroups (e.g., sample size < 10)
    significant_profiles = mortality_summary[mortality_summary['total_patients'] >= 10]
    
    # Find top high-risk profiles
    highest_28d = significant_profiles.sort_values(by='mortality_28d', ascending=False).head(1)
    highest_6m = significant_profiles.sort_values(by='mortality_6m', ascending=False).head(1)
    
    return highest_28d, highest_6m



  
